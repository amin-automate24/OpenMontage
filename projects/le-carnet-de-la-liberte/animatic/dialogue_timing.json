      "human_end_x1_2": 42.66,
      "slack_human_x1_2": 7.84,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "M1",
      "speaker": "LA MÈRE",
      "text": "À Amina, ton arrière-arrière-grand-mère. Elle a vécu les années de la lutte pour l'indépendance.",
      "shot": 9,
      "scene": 2,
      "start": 42.8,
      "synth_dur": 5.87,
      "end": 48.67,
      "shot_end": 50.5,
      "slack_synth": 1.83,
      "human_end_x1_2": 49.84,
      "slack_human_x1_2": 0.66,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "A1",
      "speaker": "AMINA",
      "text": "Papa, pourquoi tout le monde parle-t-il de liberté ?",
      "shot": 14,
      "scene": 3,
      "start": 71.0,
      "synth_dur": 2.98,
      "end": 73.98,
      "shot_end": 77.0,
      "slack_synth": 3.02,
      "human_end_x1_2": 74.57,
      "slack_human_x1_2": 2.43,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "P1",
      "speaker": "LE PÈRE",
      "text": "Parce que notre pays vit sous le protectorat. Beaucoup de Marocains veulent qu'il retrouve son indépendance.",
      "shot": 15,
      "scene": 3,
      "start": 77.5,
      "synth_dur": 6.72,
      "end": 84.22,
      "shot_end": 86.0,
      "slack_synth": 1.78,
      "human_end_x1_2": 85.56,
      "slack_human_x1_2": 0.44,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "P2",
      "speaker": "LE PÈRE",
      "text": "Aujourd'hui, des nationalistes marocains ont présenté un document pour réclamer l'indépendance de notre pays.",
      "shot": 17,
      "scene": 3,
      "start": 91.5,
      "synth_dur": 6.55,
      "end": 98.05,
      "shot_end": 99.5,
      "slack_synth": 1.45,
      "human_end_x1_2": 99.36,
      "slack_human_x1_2": 0.14,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "A2",
      "speaker": "AMINA",
      "text": "Mais que signifie être indépendant ?",
      "shot": 18,
      "scene": 3,
      "start": 99.8,
      "synth_dur": 2.0,
      "end": 101.8,
      "shot_end": 109.0,
      "slack_synth": 7.2,
      "human_end_x1_2": 102.2,
      "slack_human_x1_2": 6.8,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "P3",
      "speaker": "LE PÈRE",
      "text": "C'est pouvoir décider de l'avenir de son pays, librement et avec souveraineté.",
      "shot": 18,
      "scene": 3,
      "start": 102.0,
      "synth_dur": 5.16,
      "end": 107.16,
      "shot_end": 109.0,
      "slack_synth": 1.84,
      "human_end_x1_2": 108.19,
      "slack_human_x1_2": 0.81,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "R1",
      "speaker": "VOIX RADIO (reconstitution fictive)",
      "text": "Le sultan Mohammed Ben Youssef a été déposé et contraint à l'exil avec sa famille.",
      "shot": 22,
      "scene": 4,
      "start": 126.5,
      "synth_dur": 5.41,
      "end": 131.91,
      "shot_end": 134.0,
      "slack_synth": 2.09,
      "human_end_x1_2": 132.99,
      "slack_human_x1_2": 1.01,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "A4",
      "speaker": "AMINA",
      "text": "Père… est-ce que notre rêve est terminé ?",
      "shot": 23,
      "scene": 4,
      "start": 134.3,
      "synth_dur": 2.65,
      "end": 136.95,
      "shot_end": 145.5,
      "slack_synth": 8.55,
      "human_end_x1_2": 137.48,
      "slack_human_x1_2": 8.02,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "P4",
      "speaker": "LE PÈRE",
      "text": "Non, Amina. Malgré les épreuves, beaucoup de Marocains poursuivent la lutte pour l'indépendance.",
      "shot": 23,
      "scene": 4,
      "start": 137.4,
      "synth_dur": 6.78,
      "end": 144.18,
      "shot_end": 145.5,
      "slack_synth": 1.32,
      "human_end_x1_2": 145.54,
      "slack_human_x1_2": -0.04,
      "fits_synth": true,
      "fits_human_x1_2": false
    },
    {
      "key": "V1",
      "speaker": "VOIX HORS CHAMP",
      "text": "Amina ! Le sultan revient au Maroc !",
      "shot": 26,
      "scene": 4,
      "start": 166.5,
      "synth_dur": 2.83,
      "end": 169.33,
      "shot_end": 175.0,
      "slack_synth": 5.67,
      "human_end_x1_2": 169.89,
      "slack_human_x1_2": 5.11,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "A5",
      "speaker": "AMINA",
      "text": "Il est revenu ! Notre espoir renaît !",
      "shot": 28,
      "scene": 5,
      "start": 182.5,
      "synth_dur": 2.72,
      "end": 185.22,
      "shot_end": 189.5,
      "slack_synth": 4.28,
      "human_end_x1_2": 185.77,
      "slack_human_x1_2": 3.73,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "A6",
      "speaker": "AMINA",
      "text": "Le chemin a été long. Mais nous approchons enfin de notre rêve.",
      "shot": 30,
      "scene": 5,
      "start": 199.5,
      "synth_dur": 3.98,
      "end": 203.48,
      "shot_end": 208.5,
      "slack_synth": 5.02,
      "human_end_x1_2": 204.28,
      "slack_human_x1_2": 4.22,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "P5",
      "speaker": "LE PÈRE",
      "text": "Amina, la France vient de reconnaître officiellement l'indépendance du Maroc !",
      "shot": 32,
      "scene": 5,
      "start": 216.8,
      "synth_dur": 5.09,
      "end": 221.89,
      "shot_end": 225.5,
      "slack_synth": 3.61,
      "human_end_x1_2": 222.91,
      "slack_human_x1_2": 2.59,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "A7",
      "speaker": "AMINA",
      "text": "Tant de personnes ont espéré ce jour…",
      "shot": 32,
      "scene": 5,
      "start": 221.7,
      "synth_dur": 2.37,
      "end": 224.07,
      "shot_end": 225.5,
      "slack_synth": 1.43,
      "human_end_x1_2": 224.54,
      "slack_human_x1_2": 0.96,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "A8",
      "speaker": "AMINA",
      "text": "J'espère que les enfants de demain se souviendront de notre histoire.",
      "shot": 34,
      "scene": 5,
      "start": 240.5,
      "synth_dur": 3.77,
      "end": 244.27,
      "shot_end": 250.0,
      "slack_synth": 5.73,
      "human_end_x1_2": 245.03,
      "slack_human_x1_2": 4.97,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "T4",
      "speaker": "LA MAÎTRESSE",
      "text": "Alors Younes, qu'as-tu appris ?",
      "shot": 35,
      "scene": 6,
      "start": 250.2,
      "synth_dur": 2.06,
      "end": 252.26,
      "shot_end": 252.5,
      "slack_synth": 0.24,
      "human_end_x1_2": 252.68,
      "slack_human_x1_2": -0.18,
      "fits_synth": true,
      "fits_human_x1_2": false
    },
    {
      "key": "Y4",
      "speaker": "YOUNES",
      "text": "Que l'indépendance est le résultat de longues années de lutte et de sacrifices. Et que nous devons en être dignes !",
      "shot": 36,
      "scene": 6,
      "start": 252.7,
      "synth_dur": 5.54,
      "end": 258.24,
      "shot_end": 259.0,
      "slack_synth": 0.76,
