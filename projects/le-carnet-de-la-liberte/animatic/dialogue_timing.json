      "slack_human_x1_2": -0.35,
      "fits_synth": true,
      "fits_human_x1_2": false
    },
    {
      "key": "T5",
      "speaker": "LA MAÎTRESSE",
      "text": "Comment ?",
      "shot": 37,
      "scene": 6,
      "start": 259.1,
      "synth_dur": 0.82,
      "end": 259.92,
      "shot_end": 265.5,
      "slack_synth": 5.58,
      "human_end_x1_2": 260.09,
