{
  "lines": [
    {
      "key": "T1",
      "speaker": "LA MAÎTRESSE",
      "text": "Les enfants, pourquoi célébrons-nous cette journée ?",
      "shot": 2,
      "scene": 1,
      "start": 7.5,
      "synth_dur": 2.99,
      "end": 10.49,
      "shot_end": 11.5,
      "slack_synth": 1.01,
      "human_end_x1_2": 11.09,
      "slack_human_x1_2": 0.41,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "Y1",
      "speaker": "YOUNES",
      "text": "Parce que le Maroc est devenu indépendant !",
      "shot": 3,
      "scene": 1,
      "start": 11.8,
      "synth_dur": 2.28,
      "end": 14.08,
      "shot_end": 15.0,
      "slack_synth": 0.92,
      "human_end_x1_2": 14.53,
      "slack_human_x1_2": 0.47,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "T2",
      "speaker": "LA MAÎTRESSE",
      "text": "Très bien ! Mais comment notre pays a-t-il obtenu son indépendance ?",
      "shot": 4,
      "scene": 1,
      "start": 15.3,
      "synth_dur": 4.11,
      "end": 19.41,
      "shot_end": 20.5,
      "slack_synth": 1.09,
      "human_end_x1_2": 20.23,
      "slack_human_x1_2": 0.27,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "Y2",
      "speaker": "YOUNES",
      "text": "Je… je ne connais pas toute l'histoire.",
      "shot": 5,
      "scene": 1,
      "start": 20.8,
      "synth_dur": 2.27,
      "end": 23.07,
      "shot_end": 27.5,
      "slack_synth": 4.43,
      "human_end_x1_2": 23.52,
      "slack_human_x1_2": 3.98,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "T3",
      "speaker": "LA MAÎTRESSE",
      "text": "Alors, découvre-la et raconte-la-nous demain !",
      "shot": 5,
      "scene": 1,
      "start": 23.8,
      "synth_dur": 2.71,
      "end": 26.51,
      "shot_end": 27.5,
      "slack_synth": 0.99,
      "human_end_x1_2": 27.05,
      "slack_human_x1_2": 0.45,
      "fits_synth": true,
      "fits_human_x1_2": true
    },
    {
      "key": "Y3",
      "speaker": "YOUNES",
      "text": "Maman ! À qui appartient ce carnet ?",
      "shot": 9,
      "scene": 2,
      "start": 39.8,
      "synth_dur": 2.39,
      "end": 42.19,
      "shot_end": 50.5,
